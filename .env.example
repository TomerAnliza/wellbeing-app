# תבנית לסטודנטים — סוכן קביעת פגישות חכם, 9 בספטמבר 2026
# העתיקו ל־.env ומלאו את הפרטים שלכם. הקובץ הזה אינו מכיל סודות.
# אין דרישה לשרת Coolify או למפתחות SSH כדי לבנות את התרחיש.
# במופע n8n משלכם צרו חיבורי Gemini, OpenAI ו־Google Sheets.
# OAuth דורש הרשאת Google; אין להעתיק access/refresh tokens לתבנית.
# Google Sheets: name,email,request,summary,meeting_type,preferred_date,preferred_time,status
# .env אינו נטען אוטומטית ב־n8n מרוחק: העתיקו את המפתחות ל־Credentials
# ואת ההגדרות לצמתים. הבחירה AI_PROVIDER היא מוסכמה לתרגיל בלבד:
# התרחיש הנוכחי משתמש ב־Gemini; מעבר ל־OpenAI דורש התאמת צומת המודל.
# אל תשתפו .env. עלויות ומכסות נקבעות בחשבון של כל ספק.


# n8n — כתובת העורך. המשתמש הוא כתובת דוא״ל, לא HTTP Basic Auth.
N8N_URL=https://n8n.example.com
N8N_USERNAME=student@example.com

# אופציונלי לתיעוד מקומי בלבד; ה־API משתמש ב־N8N_API_KEY.
N8N_PASSWORD=''

# נשלח בכותרת X-N8N-API-KEY. מזהי Credentials תקפים רק במופע שבו נוצרו.
N8N_API_KEY=''
N8N_WORKFLOW_ID=''
N8N_FORM_PATH=smart-meeting-gemini-20260909

# ספקי AI — gemini או openai. הבחירה כאן אינה משנה אוטומטית את התרחיש בשרת.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# להשלמה: מפתח מ־Google AI Studio. ב־n8n צרו Google Gemini(PaLM) Api Credential.
GEMINI_API_KEY=''
N8N_GEMINI_CREDENTIAL_ID=''

# OpenAI — הוסיפו מפתח של הפרויקט שלכם; a601_openai הוא שם החיבור בהדגמת המרצה.
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=''
N8N_OPENAI_CREDENTIAL_NAME=a601_openai
N8N_OPENAI_CREDENTIAL_ID=''

# Google Sheets — צרו OAuth Credential משלכם ובחרו גיליון עם כותרות השדות המתאימות.
GOOGLE_ACCOUNT_EMAIL=student@example.com
N8N_GOOGLE_SHEETS_CREDENTIAL_ID=''
GOOGLE_SHEETS_DOCUMENT_ID=''
GOOGLE_SHEETS_TAB_NAME=Leads
GOOGLE_SHEETS_TAB_ID=''

# Google Calendar — משמש את טופס ההזמנה הקיים; התרחיש החדש רק מפנה אליו.
N8N_GOOGLE_CALENDAR_CREDENTIAL_ID=''
GOOGLE_CALENDAR_ID=primary
BOOKING_URL=https://example.com/book
APP_TIMEZONE=Asia/Jerusalem

# למי שמקים מופע משלו: OAuth של Google. בחיבורים קיימים אין צורך להזין מחדש.
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''
GOOGLE_OAUTH_REDIRECT_URI=https://n8n.example.com/rest/oauth2-credential/callback
